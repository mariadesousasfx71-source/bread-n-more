# ---- Copy this file to ".env" (same folder) and fill in your own values ----

PORT=4000
NODE_ENV=development

# MongoDB connection string.
#   Local MongoDB:  mongodb://127.0.0.1:27017
#   MongoDB Atlas:  paste the string Atlas gives you and replace <db_password> with your password
# The app always uses the database named in DB_NAME.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=breadandmore

# Any long random text. Used to sign login tokens. Keep it private.
JWT_SECRET=change-this-to-a-long-random-text
JWT_EXPIRES_IN=1d

# Which website addresses may call this API (CORS). Separate several with commas.
CLIENT_URL=http://localhost:5173

# The first admin account. "npm run seed" creates it. You make these up yourself.
ADMIN_NAME=Bread and More Admin
ADMIN_EMAIL=admin@breadandmore.com
ADMIN_PASSWORD=ChangeThisPassword123

# Time zone used for "today" and the daily revenue report (India = +05:30)
UTC_OFFSET=+05:30

# Login attempts allowed per 15 minutes from one address (rate limiting)
AUTH_RATE_LIMIT=20
